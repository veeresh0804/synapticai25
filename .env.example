# Supabase Credentials
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-supabase-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Frontend Env
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Optional: override AI model per deploy (edge _shared/ai.ts reads AI_MODEL, e.g. gemini-2.5-flash)
AI_MODEL=
# Edge auth reads SUPABASE_ANON_KEY (exact name); PUBLISHABLE_KEY alone is not enough there
SUPABASE_ANON_KEY=
# Legacy alias also accepted by Java (prefers GEMINI_API_KEY, falls back to AI_PROVIDER_API_KEY)
GEMINI_API_KEY=

# Backend (Spring Boot, http://localhost:8081) - REQUIRED, no defaults committed
# Min 32 chars. Generate with: openssl rand -base64 32
JWT_SECRET=
# Required to enable POST /api/seed-users. Empty = seeding disabled.
SEED_SECRET=
# Optional for live AI; without it AI endpoints fall back / return errors
AI_PROVIDER_API_KEY=

# Google Sign-In (local database mode)
# 1. Go to https://console.cloud.google.com/apis/credentials -> Create OAuth Client ID (Web)
# 2. Authorized JavaScript origins: http://localhost:8080
# 3. Copy the SAME client ID into both vars below.
# Frontend (GIS button on login pages):
VITE_GOOGLE_CLIENT_ID=
# Backend (verifies ID tokens in POST /api/auth/google, aud-checked):
GOOGLE_CLIENT_ID=
